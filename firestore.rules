rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // ─── Helper Functions ───────────────────────────────────────
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == "admin";
    }

    function isOwner(userId) {
      return isAuthenticated() && request.auth.uid == userId;
    }

    // ─── Users Collection ───────────────────────────────────────
    // Users can read their own profile. Only admins can read all users.
    // Users can update their own profile (but not change their role).
    // Only admins can create/delete user documents or change roles.
    match /users/{userId} {
      allow read: if isOwner(userId) || isAdmin();
      allow create: if isOwner(userId);
      allow update: if isOwner(userId) &&
        !request.resource.data.diff(resource.data).affectedKeys().hasAny(["role", "roles"]);
      allow update, delete: if isAdmin();
    }

    // ─── Admin-Only Collections ─────────────────────────────────
    // Only admins can read or write admin data.
    match /admin/{document=**} {
      allow read, write: if isAdmin();
    }

    // ─── Tasks Collection ───────────────────────────────────────
    // All authenticated users can read tasks.
    // Only admins can create, update, or delete tasks.
    match /tasks/{taskId} {
      allow read: if isAuthenticated();
      allow create, update, delete: if isAdmin();
    }

    // ─── Feedback Collection ────────────────────────────────────
    // Any authenticated user can submit feedback.
    // Only admins can read all feedback.
    match /feedback/{feedbackId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // ─── Weather Data ───────────────────────────────────────────
    // All authenticated users can read weather data.
    // Only admins can write weather data.
    match /weather/{document=**} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // ─── Public Collections ─────────────────────────────────────
    // Publicly readable data (e.g., app metadata).
    match /public/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ─── Default Deny ───────────────────────────────────────────
    // Any collection not explicitly matched above is denied by default.
  }
}